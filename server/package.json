{
  "name": "groundcheck-mcp",
  "version": "0.6.0",
  "description": "MCP server for live-source claim verification, citation checking, FIGI resolution, atomic claim extraction, and signed delivery receipts.",
  "mcpName": "io.github.beepboop2025/groundcheck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beepboop2025/groundcheck.git",
    "directory": "server"
  },
  "homepage": "https://groundcheck.seiche.info",
  "type": "module",
  "bin": {
    "groundcheck": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fact-check",
    "grounding",
    "hallucination",
    "ai-agents",
    "claude"
